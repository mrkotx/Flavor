<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationLine" />

    <View
        android:id="@+id/bottomNavigationLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/add_button"
        android:layout_marginBottom="10dp"
        android:background="@color/line_color" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_button"
        android:layout_width="80dp"
        android:layout_height="56dp"
        app:icon="@drawable/add"
        app:iconGravity="textStart"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        app:iconPadding="0dp"
        app:iconSize="36dp"
        android:backgroundTint="@color/buttons_color"
        app:cornerRadius="28dp"
        android:contentDescription="Добавить рецепт" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/acc"
        app:iconGravity="textStart"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        android:backgroundTint="@color/buttons_color"
        app:cornerRadius="28dp"
        android:contentDescription="Профиль" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saved_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/book"
        app:iconGravity="textStart"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_toStartOf="@id/profile_button"
        android:layout_marginEnd="16dp"
        android:layout_alignParentBottom="true"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        android:backgroundTint="@color/buttons_color"
        app:cornerRadius="28dp"
        android:contentDescription="Сохраненное" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/search"
        app:iconGravity="textStart"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        android:backgroundTint="@color/buttons_color"
        app:cornerRadius="28dp"
        android:contentDescription="Поиск" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/home"
        app:iconGravity="textStart"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:layout_toEndOf="@id/search_button"
        android:layout_marginStart="16dp"
        android:layout_alignParentBottom="true"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        android:backgroundTint="@color/buttons_color"
        app:cornerRadius="28dp"
        android:contentDescription="Лента" />

</RelativeLayout>